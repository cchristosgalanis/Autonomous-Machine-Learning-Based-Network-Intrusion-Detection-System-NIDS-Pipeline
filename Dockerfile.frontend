FROM python:3.10-slim

WORKDIR /app

# Install Streamlit and visualization libraries
RUN pip install --no-cache-dir streamlit pandas plotly

# Create the logs directory structure just in case
RUN mkdir -p /app/logs

# Copy the frontend application code
COPY src/frontend_app.py .

# Expose Streamlit default port
EXPOSE 8501

# Run the Streamlit application
CMD ["streamlit", "run", "frontend_app.py", "--server.port=8501", "--server.address=0.0.0.0"]